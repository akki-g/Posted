# Production env file for `compose.production.yml`.
# Copy this to `.env.production` (already gitignored), fill in real values,
# and run:
#   docker network create portfolio-edge   # once, if it doesn't exist yet
#   docker compose -f compose.production.yml --env-file .env.production up -d --build
#
# DATABASE_URL, APP_ENV, and DEMO_MODE are set directly in compose.production.yml
# and don't need to be repeated here.

APP_NAME=Posted
API_PREFIX=/api/v1
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# Long random secret -- used to sign session tokens and OAuth CSRF state.
# `openssl rand -hex 32` works well. Different from your local dev .env's value.
APP_SECRET=

# Password for the Postgres container -- pick a long random value.
POSTGRES_PASSWORD=

# Replace with your real deployed domain (matches the personal-portfolio edge
# nginx server_name and the redirect URIs registered with Google/Schwab below).
FRONTEND_ORIGINS=https://posted.example.com
FRONTEND_APP_URL=https://posted.example.com/settings
FRONTEND_LOGIN_CALLBACK_URL=https://posted.example.com/login/callback

# Google OAuth. GOOGLE_REDIRECT_URI must be registered exactly as written here
# in the Google Cloud Console OAuth client's authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://posted.example.com/api/v1/auth/google/callback

# Schwab read-only integration. Redirect URI must exactly match the approved app value.
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=https://posted.example.com/api/v1/connections/schwab/callback

# Plaid banking integration
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENVIRONMENT=production
PLAID_WEBHOOK_URL=
PLAID_REDIRECT_URI=
PLAID_ANDROID_PACKAGE_NAME=com.posted.portfolio

# OpenBB provider credentials. Configure only the providers you use.
OPENBB_FMP_API_KEY=
OPENBB_BENZINGA_API_KEY=
OPENBB_INTRINIO_API_KEY=
OPENBB_NEWS_PROVIDER=yfinance

# Stock research + news. Alpaca supplies IEX bars/news; Finnhub adds enrichment,
# earnings, insider transactions, monthly insider sentiment, and company news.
ALPACA_API_KEY=
ALPACA_API_SECRET=
FINNHUB_API_KEY=
MARKET_DATA_YAHOO_FALLBACK=true

# SEC requests should identify the application and include a contact email.
SEC_USER_AGENT=Posted contact@example.com

# Anthropic API key for event insights, insider analysis, and the morning debrief.
ANTHROPIC_API_KEY=
