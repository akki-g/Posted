APP_ENV=development
APP_NAME=Posted
API_PREFIX=/api/v1
DATABASE_URL=sqlite+aiosqlite:///./posted.db
FRONTEND_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006
DEV_USER_ID=00000000-0000-0000-0000-000000000001
DEMO_MODE=true
APP_SECRET=replace-with-a-long-random-value
FRONTEND_APP_URL=http://127.0.0.1:8081/settings

# Schwab read-only integration (leave blank for demo mode)
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=http://127.0.0.1:8000/api/v1/connections/schwab/callback

# Plaid banking integration (Sandbox is the safest place to start)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENVIRONMENT=sandbox
PLAID_WEBHOOK_URL=
PLAID_REDIRECT_URI=
PLAID_ANDROID_PACKAGE_NAME=com.posted.portfolio

# OpenBB provider credentials. Configure only the providers you use.
OPENBB_FMP_API_KEY=
OPENBB_BENZINGA_API_KEY=
OPENBB_INTRINIO_API_KEY=

# SEC requests should identify the application and include a contact email.
SEC_USER_AGENT=Posted contact@example.com
