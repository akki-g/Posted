APP_ENV=development
APP_NAME=Posted
API_PREFIX=/api/v1
DATABASE_URL=sqlite+aiosqlite:///./posted.db
FRONTEND_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006
DEV_USER_ID=00000000-0000-0000-0000-000000000001
DEMO_MODE=true
APP_SECRET=replace-with-a-long-random-value
# Web callback target. Use posted://settings for an installed mobile build.
FRONTEND_APP_URL=http://127.0.0.1:8081/settings

# Schwab read-only integration. Redirect URI must exactly match the approved app value.
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=http://127.0.0.1:8000/api/v1/connections/schwab/callback

# Google OAuth login (web only for now). Create an OAuth client under
# "Web application" in Google Cloud Console; add GOOGLE_REDIRECT_URI to its
# authorized redirect URIs list exactly as written here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback
FRONTEND_LOGIN_CALLBACK_URL=http://127.0.0.1:8081/login/callback

# Plaid banking integration (Sandbox is the safest place to start)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENVIRONMENT=sandbox
PLAID_WEBHOOK_URL=
PLAID_REDIRECT_URI=
PLAID_ANDROID_PACKAGE_NAME=com.posted.portfolio

# OpenBB provider credentials. Configure only the providers you use.
OPENBB_FMP_API_KEY=
OPENBB_BENZINGA_API_KEY=
OPENBB_INTRINIO_API_KEY=
OPENBB_NEWS_PROVIDER=yfinance

# Stock research + news. Alpaca supplies IEX bars/news; Finnhub adds enrichment,
# earnings, insider transactions, monthly insider sentiment, and company news.
ALPACA_API_KEY=
ALPACA_API_SECRET=
FINNHUB_API_KEY=
# Personal-use fallback only; disable for deployments without appropriate data rights.
MARKET_DATA_YAHOO_FALLBACK=true

# SEC requests should identify the application and include a contact email.
SEC_USER_AGENT=Posted contact@example.com

# Anthropic API key for event insights, insider analysis, and the morning debrief.
# Leave blank to disable AI text; deterministic analysis remains available.
ANTHROPIC_API_KEY=

# SignalWire local SMS testing. Create a Space, then grab the Space URL, Project
# ID, and an API token from the dashboard. Point the number's inbound message
# webhook at your tunnel URL ending in /api/v1/webhooks/signalwire (POST) and put
# that same public URL in SIGNALWIRE_WEBHOOK_URL so signature checks work behind
# the tunnel. The test phone is the only number allowed to access DEV_USER_ID.
SIGNALWIRE_SPACE_URL=
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_FROM_NUMBER=+12029006012
SIGNALWIRE_LOCAL_TEST_PHONE=+18134038236
SIGNALWIRE_WEBHOOK_URL=
# Set true only for manual curl testing; SignalWire webhooks should always be signed.
SIGNALWIRE_ALLOW_UNSIGNED_WEBHOOKS=false
# Temporary diagnostic-only flag for tracking down signature mismatches in
# production; logs a safe (no secrets) match sweep on rejected webhooks. Off by default.
SIGNALWIRE_SIGNATURE_DIAGNOSTICS=false
